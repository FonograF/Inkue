# Rust / Cargo
target/
# Isolated target dir used to validate while `pnpm tauri dev` holds target/.
# Matched at any depth: a relative CARGO_TARGET_DIR resolves against the shell's
# cwd, so the cache lands wherever cargo was invoked from — once inside src/.
target-check/
**/*.rs.bk
# Cargo.lock is committed (this is an application, not a library) so CI and
# release builds use the exact dependency versions developed/tested against.

# Node / pnpm
node_modules/
dist/
.pnpm-store/

# Tauri
src-tauri/target/
src-tauri/WixTools/

# Workspace files (user data, not source)
*.inkue
*.wincue

# Loose user data at repo root (Open Stage Control sessions, runtime config) —
# personal test artifacts, never source.
/fixtures/
/Inkue.config
/Wincue.config
/Export control.json
/inkue interface mobile.json
/inkue-monitor.json
/wincue interface mobile.json
/wincue-monitor.json

# IDE & OS
.vscode/
.vs/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# Claude Code local config
.claude/

# Markdown docs are local-only by default — the public repo ships the README
# plus the two living project documents (CLAUDE.md = contributor/agent guide,
# PROGRESS.md = ground-truth project state). Everything else (ARCHITECTURE,
# PORTAGE, CHANGELOG, RELEASING, WHATSNEXT, RENAME, release notes…) stays on
# the maintainer's machine. vendor/asiosdk/README.md is already tracked.
*.md
!README.md
!CLAUDE.md
!PROGRESS.md

# Figma redesign reference mock-up + archived docs (local only, not the app build).
/App.tsx
/docs/archive/


# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Vendor binaries — large binaries not tracked in git (copy manually or via LFS).
# libmpv-2.dll (~113 MB) lives in vendor/mpv/ and is intentionally not versioned.
src-tauri/vendor/
vendor/mpv/

# Release-asset copies downloaded during verification
latest.json
