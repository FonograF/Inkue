{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkue",
  "version": "1.1.0",
  "identifier": "com.inkue.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Inkue",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false
      },
      {
        "label": "preferences",
        "title": "Preferences",
        "width": 740,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "float-timer",
        "title": "Inkue Timer",
        "width": 420,
        "height": 110,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MEI3MkI2RTFEMTdCNApSV1MwRngxdUs3ZVFCUVJLMDVVOTZROG42Q3JTdysrNWlZWUl5Tnk1ZG9qU3F5Y2FQQVZTTXJkKwo=",
      "endpoints": [
        "https://github.com/FonograF/Inkue/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libmpv2 | libmpv1", "libxkbcommon-x11-0"]
      }
    }
  }
}
